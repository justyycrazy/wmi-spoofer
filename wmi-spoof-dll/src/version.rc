// version.rc -- version resource for wmi-spoofer.dll (ASCII only, no codepage issues).
// FILEVERSION is the launcher compatibility gate: the launcher requires >= 1.0
// and rejects older DLLs before injecting (see launcher core.rs dll_version_check).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "wmi-spoofer in-process WMI fingerprint spoofer"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "ProductName",     "wmi-spoofer"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
